# Samanvay Environment Configuration

# Database (PostgreSQL 18 with pgvector, pg_trgm, pgcrypto, btree_gin)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/samanvay

# Authentication (Hackathon-grade HS256 JWT)
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# OCR Provider (fake, local, vision)
OCR_PROVIDER=fake
OCR_CONF_MIN=0.70
OCR_FALLBACK_CONF=0.80

# LLM Extractor (off, local, hosted)
LLM_EXTRACTOR=off
LLM_BASE_URL=http://localhost:11434

# Thresholds for Tiering
TAU_AUTO=0.995
TAU_REVIEW=0.750

# System Clock & Demo Modes
CLOCK_MODE=real
DEMO_MODE=false

# ERP Target
ERP_TARGET=sap
STORAGE_PATH=./data/storage
UPLOAD_MAX_MB=15

# Optional ML Layer (off, on)
ML_LAYER=off

# Metrics
METRICS_ENABLED=true
